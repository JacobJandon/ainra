# --- build outputs (regenerated; never committed) ---
/target
**/target
**/node_modules
packages/sdk-ts/dist
**/*.rs.bk
Cargo.lock.orig
.DS_Store
/tmp
BENCHMARKS.md.tmp

# --- generated run outputs (produced by make targets; not source) ---
genesis-out/
*-out/
/build/
apps/cli-node/.ainra

# --- generated registrar demo state: contains TEST reload SEEDS (key-deriving). NEVER commit key material. ---
apps/registrar-explorer/data/
**/registrar.secret

# --- secrets of any kind (defense in depth; no real secrets should ever exist in this repo) ---
*.secret
*.key
*.pem
.env
.env.*
*.keystore

# --- fuzz: keep seed corpora + targets, ignore crash artifacts + build ---
fuzz/target/
fuzz/artifacts/
fuzz/corpus/**/crash-*
fuzz/corpus/**/leak-*
fuzz/corpus/**/timeout-*

# --- M9 kit run-outputs (evidence artifacts are generated, not committed) ---
kits/**/out/
kits/**/*.local
**/verifier-attestation*.json
**/soak-report*.json
**/ceremony-transcript*.json
# verifier challenge minting: the private ANSWER KEY must never be committed; challenge corpora are generated
**/challenge-secret*.json
**/answer-key*.json
kits/verifier/challenge/

# built TypeScript outputs (all dist/ are tsc build products)
**/dist/

# stray build artifact (never commit)
*.zip

# generated board output (render with: make genesis-status)
genesis-board*.html

# release artifacts (make release)
/dist/

# operator's private per-party working dir (holds ANSWER KEYS — never commit)
ops-verifier/

# site derived downloads (built by make site from canonical sources)
site/AINRA_I_The_Standard.md
site/ainra-cli-*.zip
.gstack/

# AINRAscan derived artifacts (regenerated by `make ainrascan`)
ainrascan/vendor/
ainrascan/data/

# derived browser SDK bundle (regenerated by make ainrascan)
packages/sdk-ts/browser/ainra-sdk.js

# staging network runtime state (make stage-up)
stage/
deploy/.env

# genesis evidence (real ceremony/verifier/soak artifacts, collected on the day)
genesis-evidence/
docs/genesis-day/declaration/founding-declaration.md
deploy/.env.production

# M16 onramp: the persistent local registrar make issue-first creates
my-registrar/

# M17 site-up runtime pid
.site-pid
.explorer-pid
# M17 derived agent surface (regenerated by `make site`)
site/standard.md
site/verify.md
site/foundations.md
site/status.md
site/openapi/
site/skills.md

# M17 regenerated proof evidence
evidence/
.release-key/

# M24 Python verifier (packages/sdk-py) build/cache artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
