# SPDX-License-Identifier: Apache-2.0 OR MIT
# AINRA public artifact server — CDN-shaped static read surface (docs/ARTIFACT-CONTRACT.md). No keys, read-only.
FROM node:22-slim
RUN useradd -r -u 10002 ainra && apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY tools/artifact-server.mjs /app/artifact-server.mjs
USER 10002
ENV AINRA_STAGE=1
EXPOSE 8091
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD curl -fsS http://127.0.0.1:8091/index.json || exit 1
ENTRYPOINT ["node", "/app/artifact-server.mjs", "/public", "8091"]
