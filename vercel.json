{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash tools/site.sh",
  "outputDirectory": "site",
  "installCommand": "true",
  "framework": null,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
